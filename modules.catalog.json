                    {
                        "id":  "IWPhone息屏深度doze",
                        "name":  "IWPhone息屏自动深度doze",
                        "version":  "1.0.0",
                        "author":  "IWPhone.lnc",
                        "description":  "iwphone官方插件，息屏后自动进入深度doze，当设备处于亮屏状态时会每x分钟进行一次检测（x取决于你选择的模式策略），当设备处于息屏后，经过大约三次检测（若此时每次检测间隔半分钟则总共约一分半）后进入深度doze状态，当设备亮屏后会继续进行大约三次检测（若此时每次检测间隔三分钟大约需要10分钟）后退出深度doze状态，目前含有，Aggressive，Moderate，Gentle三个策略可以自行尝试适合自己的模式（需要更换模式直接替换模块中对应模式的文件即可），如需手动结束doze插件进程可手动在插件工作目录下新建一个“end”文件",
                        "exclusive":  null,
                        "runtime":  "0",
                        "packagePath":  "framework/module/IWPhone息屏深度doze.iwp",
                        "sizeBytes":  2234,
                        "sha256":  "b6660d4f910663890627db2627bdbcce8a2e44ecc621a1fb0e69cc77bf920a8d"
                    },
